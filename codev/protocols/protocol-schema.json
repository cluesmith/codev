{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://codev.dev/protocol-schema.json",
  "title": "Codev Protocol Definition",
  "description": "Schema for porch protocol definitions (protocols/<name>/protocol.json). Editor tooling: porch parses these files with its own normalizer, and a test validates every shipped protocol.json against this schema.",
  "type": "object",
  "required": [
    "name",
    "version",
    "description",
    "phases"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Path to this schema, for editors"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "Protocol identifier (e.g. 'spir', 'bugfix', 'air')"
    },
    "alias": {
      "type": "string",
      "description": "Alternative name accepted wherever the protocol name is (e.g. 'spider' for spir)"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic version of the protocol"
    },
    "description": {
      "type": "string"
    },
    "input": {
      "$ref": "#/definitions/protocolInput"
    },
    "hooks": {
      "$ref": "#/definitions/protocolHooks"
    },
    "context_refresh": {
      "type": "object",
      "description": "Boundaries at which builders automatically refresh their context (Spec 1470). Absent means no refreshes.",
      "additionalProperties": false,
      "properties": {
        "on_enter": {
          "type": "array",
          "description": "Protocol phase ids to refresh on entry to. Each must name a phase this protocol declares.",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "on_plan_phase_advance": {
          "type": "boolean",
          "description": "Refresh when advancing from one plan phase to the next. Requires a 'per_plan_phase' phase. Excludes the first plan phase, which coincides with entering the phase itself."
        }
      }
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/phase"
      },
      "description": "Ordered list of protocol phases"
    },
    "phase_completion": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "Named predicates (shell commands). Their names are valid porch.checks override keys; porch does not run them."
    },
    "signals": {
      "type": "object",
      "description": "Legacy: porch does not read this. Builders finish a phase with `porch done` and report blockers with `afx send architect`.",
      "additionalProperties": {
        "type": "object"
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "strict",
            "soft"
          ],
          "description": "Default orchestration mode"
        },
        "max_iterations": {
          "type": "integer",
          "minimum": 1
        },
        "checks": {
          "type": "object",
          "description": "Default check commands, overridden by a phase's own checks",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "command": {
                    "type": "string",
                    "description": "Shell command to run. A check without one is a named requirement the builder satisfies (e.g. BUGFIX regression_test); porch runs only checks that have a command."
                  },
                  "description": {
                    "type": "string"
                  },
                  "cwd": {
                    "type": "string",
                    "description": "Working directory relative to the project root"
                  },
                  "timeout_ms": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 2147483647,
                    "description": "Kill the check after this many milliseconds (default: 300000, i.e. 5 minutes)"
                  },
                  "on_fail": {
                    "type": "string",
                    "description": "'retry', or a phase id to return to"
                  },
                  "max_retries": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "optional": {
                    "type": "boolean",
                    "description": "A failure does not block the phase"
                  },
                  "required": {
                    "type": "boolean"
                  },
                  "skip_requires_justification": {
                    "type": "boolean",
                    "description": "Skipping this check must be justified in the commit and PR"
                  }
                }
              }
            ]
          }
        },
        "consultation": {
          "type": "object",
          "additionalProperties": false,
          "description": "Descriptive only: porch takes lanes from a phase's verify or consultation block and from .codev/config.json porch.consultation.",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "models": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "May be empty for protocols that run no consultation"
            },
            "parallel": {
              "type": "boolean"
            }
          }
        },
        "verify": {
          "type": "object",
          "additionalProperties": false,
          "description": "Descriptive only: each build_verify phase carries its own verify block.",
          "properties": {
            "models": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            },
            "parallel": {
              "type": "boolean"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "phase": {
      "type": "object",
      "required": [
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique phase identifier"
        },
        "name": {
          "type": "string",
          "description": "Human-readable phase name (defaults to id)"
        },
        "description": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "once",
            "per_plan_phase",
            "build_verify"
          ],
          "description": "once: one task, the builder runs `porch done`. build_verify: build, then consultation, iterated until reviewers approve. per_plan_phase: build_verify once per phase of the plan."
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Descriptive step names; porch does not read them"
        },
        "build": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "prompt"
          ],
          "properties": {
            "prompt": {
              "type": "string",
              "description": "Prompt file in prompts/"
            },
            "artifact": {
              "type": "string",
              "description": "Artifact glob; ${PROJECT_ID} and ${PROJECT_TITLE} are substituted"
            }
          }
        },
        "verify": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "type",
            "models"
          ],
          "properties": {
            "type": {
              "type": "string",
              "description": "consult review type (spec, plan, impl, pr, phase)"
            },
            "models": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            },
            "parallel": {
              "type": "boolean"
            }
          },
          "description": "Consultation porch emits after `porch done` (build_verify phases); null means the phase has none (its gate is the review). .codev/config.json porch.consultation overrides the lanes."
        },
        "consultation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "models"
          ],
          "properties": {
            "type": {
              "type": "string",
              "description": "consult review type"
            },
            "models": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            }
          },
          "description": "Consultation the builder runs from a once phase's prompt (BUGFIX/AIR PR phase). Porch renders the commands into {{consult_commands}}, applying .codev/config.json porch.consultation. There is no enabled or parallel switch: turn reviewers off or change them in porch.consultation."
        },
        "max_iterations": {
          "type": "integer",
          "minimum": 1,
          "description": "Safety ceiling on build-verify iterations (default 8)"
        },
        "on_complete": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "commit": {
              "type": "boolean"
            },
            "push": {
              "type": "boolean"
            }
          },
          "description": "Descriptive: porch commits only status.yaml; the builder commits the phase's work."
        },
        "checks": {
          "type": "object",
          "description": "Checks run by `porch check` / `porch done` for this phase",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "command": {
                    "type": "string",
                    "description": "Shell command to run. A check without one is a named requirement the builder satisfies (e.g. BUGFIX regression_test); porch runs only checks that have a command."
                  },
                  "description": {
                    "type": "string"
                  },
                  "cwd": {
                    "type": "string",
                    "description": "Working directory relative to the project root"
                  },
                  "timeout_ms": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 2147483647,
                    "description": "Kill the check after this many milliseconds (default: 300000, i.e. 5 minutes)"
                  },
                  "on_fail": {
                    "type": "string",
                    "description": "'retry', or a phase id to return to"
                  },
                  "max_retries": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "optional": {
                    "type": "boolean",
                    "description": "A failure does not block the phase"
                  },
                  "required": {
                    "type": "boolean"
                  },
                  "skip_requires_justification": {
                    "type": "boolean",
                    "description": "Skipping this check must be justified in the commit and PR"
                  }
                }
              }
            ]
          }
        },
        "gate": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/definitions/gate"
            }
          ],
          "description": "Human approval gate after this phase: a gate name, or an object with name and next"
        },
        "transition": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "on_complete": {
              "type": [
                "string",
                "null"
              ],
              "description": "Next phase id (null: terminal)"
            },
            "on_all_phases_complete": {
              "type": "string",
              "description": "Next phase once every plan phase is done (per_plan_phase)"
            }
          }
        },
        "next": {
          "type": [
            "string",
            "null"
          ],
          "description": "Next phase id (null: terminal); defaults to the following phase"
        }
      }
    },
    "gate": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "requires": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "next": {
          "type": [
            "string",
            "null"
          ],
          "description": "Next phase after the gate (null: terminal)"
        }
      }
    },
    "protocolInput": {
      "type": "object",
      "additionalProperties": false,
      "description": "What input a protocol accepts at spawn",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "spec",
            "github-issue",
            "task",
            "protocol",
            "shell",
            "worktree",
            "none"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "default_for": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "CLI flags this protocol is the default for (e.g. ['--issue', '-i'])"
        }
      }
    },
    "protocolHooks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pre-spawn": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "collision-check": {
              "type": "boolean",
              "description": "Check for worktree/PR collisions before spawning"
            },
            "comment-on-issue": {
              "type": "string",
              "description": "Comment posted on the issue at spawn"
            }
          }
        }
      }
    }
  }
}
