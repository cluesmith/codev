    },
    {
      "command": "codev.startEditBuilderComment",
      "group": "group@1",
      "when": "commentController == codev-builder-review && comment == pending-builder-comment",
    },
  ],
  "comments/commentThread/context": [
    {
      "command": "codev.submitReviewComment",
