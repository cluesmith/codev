      "command": "codev.referenceIssueInArchitect",
      "group": "inline@1",
      "when": "view == codev.backlog && viewItem == backlog-item",
    },
    {
      "command": "codev.openPullRequestInBrowser",
      "group": "inline@0",
      "when": "view == codev.pullRequests && viewItem == pull-request",
    },
    {
      "command": "codev.openPullRequestInBrowser",
      "group": "1_primary@1",
      "when": "view == codev.pullRequests && viewItem == pull-request",
    },
    {
      "command": "codev.referencePRInArchitect",
      "group": "inline@1",
      "when": "view == codev.pullRequests && viewItem == pull-request",
    },
    {
      "command": "codev.viewBacklogIssue",
      "group": "1_primary@1",
      "when": "view == codev.backlog && viewItem == backlog-item",
    },
    {
      "command": "codev.spawnBuilder",
      "group": "1_primary@2",
      "when": "view == codev.backlog && viewItem == backlog-item",
    },
    {
      "command": "codev.openBacklogIssue",
      "group": "1_primary@3",
      "when": "view == codev.backlog && viewItem == backlog-item",
    },
    {
      "command": "codev.copyBacklogIssueNumber",
      "group": "1_primary@4",
      "when": "view == codev.backlog && viewItem == backlog-item",
    },
  ],
  "view/title": [
    {
      "command": "codev.tower.refresh",
      "group": "navigation@1",
      "when": "view == codev.tower",
    },
    {
      "command": "codev.refreshOverview",
      "group": "navigation@2",
      "when": "view == codev.agents",
    },
    {
      "command": "codev.disableBuildersAutoCollapse",
      "group": "navigation@3",
      "when": "view == codev.agents && codev.buildersAutoCollapse",
    },
    {
      "command": "codev.enableBuildersAutoCollapse",
      "group": "navigation@3",
      "when": "view == codev.agents && !codev.buildersAutoCollapse",
    },
    {
      "command": "codev.disableBuildersFileTreeMode",
      "group": "navigation@4",
      "when": "view == codev.agents && codev.buildersFileViewAsTree",
    },
    {
      "command": "codev.enableBuildersFileTreeMode",
      "group": "navigation@4",
      "when": "view == codev.agents && !codev.buildersFileViewAsTree",
    },
    {
      "command": "codev.agentsCycleGroupFromStage",
      "group": "navigation@1",
      "when": "view == codev.agents && (!codev.buildersGroupBy || codev.buildersGroupBy == 'stage')",
    },
    {
      "command": "codev.agentsCycleGroupFromArea",
      "group": "navigation@1",
      "when": "view == codev.agents && codev.buildersGroupBy == 'area'",
    },
    {
      "command": "codev.agentsCycleGroupFromArchitect",
      "group": "navigation@1",
      "when": "view == codev.agents && codev.buildersGroupBy == 'architect'",
    },
    {
      "command": "codev.refreshOverview",
      "group": "navigation",
      "when": "view == codev.pullRequests",
    },
    {
      "command": "codev.disableBuildersFileTreeMode",
      "group": "navigation@1",
      "when": "view == codev.pullRequests && codev.buildersFileViewAsTree",
    },
    {
      "command": "codev.enableBuildersFileTreeMode",
      "group": "navigation@1",
      "when": "view == codev.pullRequests && !codev.buildersFileViewAsTree",
    },
    {
      "command": "codev.openBacklogSearch",
      "group": "navigation@0",
      "when": "view == codev.backlog",
    },
    {
      "command": "codev.refreshOverview",
      "group": "navigation",
      "when": "view == codev.backlog",
    },
    {
      "command": "codev.showBacklogAll",
      "group": "navigation",
      "when": "view == codev.backlog && !codev.backlogShowAll",
    },
    {
      "command": "codev.showBacklogMineOnly",
      "group": "navigation",
      "when": "view == codev.backlog && codev.backlogShowAll",
    },
    {
      "command": "codev.refreshOverview",
      "group": "navigation",
      "when": "view == codev.recentlyClosed",
    },
    {
      "command": "codev.refreshTeam",
      "group": "navigation",
      "when": "view == codev.team",
    },
    {
      "command": "codev.reconnect",
      "group": "navigation",
      "when": "view == codev.status",
    },
  ],
}
`;

exports[`existing containers, views and menus are unchanged > their views 1`] = `
[
  {
    "id": "codev.workspace",
    "name": "Workspace",
    "when": "codev.hasWorkspace",
  },
  {
    "id": "codev.agents",
    "name": "Agents",
    "when": "!codev.isBuilderWorktree",
  },
  {
    "id": "codev.backlog",
    "name": "Backlog",
    "when": "codev.hasWorkspace",
  },
  {
    "id": "codev.pullRequests",
    "name": "Pull Requests",
    "visibility": "collapsed",
    "when": "codev.hasWorkspace",
  },
  {
    "id": "codev.recentlyClosed",
    "name": "Recently Closed",
    "visibility": "collapsed",
    "when": "codev.hasWorkspace",
  },
  {
    "id": "codev.team",
    "name": "Team",
    "visibility": "collapsed",
    "when": "codev.teamEnabled && codev.hasWorkspace",
  },
  {
    "id": "codev.status",
    "name": "Status",
    "visibility": "collapsed",
    "when": "codev.hasWorkspace || codev.ideMode",
  },
]
`;
