    },
    {
      "command": "codev.openWorktreeFolder",
      "group": "2_worktree@2",
      "when": "view == codev.agents && viewItem =~ /^(builder|blocked-builder|awaiting-builder)-/",
    },
    {
      "command": "codev.runWorktreeSetup",
      "group": "3_dev@1",
      "when": "view == codev.agents && viewItem =~ /^(builder|blocked-builder|awaiting-builder)-/",
    },
    {
      "command": "codev.runWorktreeDev",
