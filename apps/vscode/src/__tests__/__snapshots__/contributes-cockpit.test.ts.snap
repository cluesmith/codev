      "when": "commentController == codev-review && commentThreadIsEmpty",
    },
    {
      "command": "codev.submitBuilderComment",
      "group": "inline@1",
      "when": "commentController == codev-builder-review && commentThreadIsEmpty && codev.diffCodelensMode == 'comment'",
    },
    {
      "command": "codev.forwardBuilderComment",
      "group": "inline@1",
      "when": "commentController == codev-builder-review && commentThreadIsEmpty && codev.diffCodelensMode != 'comment'",
    },
    {
      "command": "codev.cancelBuilderComment",
      "group": "inline@2",
      "when": "commentController == codev-builder-review && commentThreadIsEmpty",
    },
  ],
