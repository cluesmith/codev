{
  "name": "@cluesmith/codev-core",
  "version": "3.3.6",
  "description": "Server-side runtime for Codev — local-key issuance and homedir-derived paths. Client-side Tower access lives in @cluesmith/codev-sdk; the two packages never import each other.",
  "type": "module",
  "exports": {
    "./auth": {
      "types": "./dist/auth.d.ts",
      "default": "./dist/auth.js"
    },
    "./constants": {
      "types": "./dist/constants.d.ts",
      "default": "./dist/constants.js"
    },
    "./agent-state": {
      "types": "./dist/agent-state.d.ts",
      "default": "./dist/agent-state.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "@types/node": "22.x",
    "typescript": "catalog:",
    "vitest": "^4.0.15"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@cluesmith/codev-types": "workspace:*"
  }
}
